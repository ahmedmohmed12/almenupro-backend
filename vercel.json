{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "almenupro-backend",
  "framework": null,
  "installCommand": "node scripts/preparePublicUploads.js",
  "buildCommand": "node scripts/preparePublicUploads.js && node scripts/verifyVercelDeploy.js",
  "outputDirectory": null,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "lib/**/*.js",
          "uploads/menu/**",
          "public/menu-images/**"
        ]
      }
    },
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "lib/**/*.js",
          "uploads/menu/**",
          "public/menu-images/**"
        ]
      }
    },
    {
      "src": "api/kitchens.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "lib/**/*.js"
        ]
      }
    },
    {
      "src": "api/delivery-zones.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "lib/**/*.js"
        ]
      }
    },
    {
      "src": "apiServer.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "lib/**/*.js",
          "uploads/menu/**",
          "public/menu-images/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/kitchens",
      "dest": "/api/kitchens.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Restaurant-Id"
      }
    },
    {
      "src": "/api/kitchens/(.*)",
      "dest": "/api/kitchens.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Restaurant-Id"
      }
    },
    {
      "src": "/api/delivery-zones",
      "dest": "/api/delivery-zones.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Restaurant-Id"
      }
    },
    {
      "src": "/api/delivery-zones/(.*)",
      "dest": "/api/delivery-zones.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Restaurant-Id"
      }
    },
    {
      "src": "/menu-images/(.*)",
      "dest": "/apiServer.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/og/(.*)",
      "dest": "/apiServer.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/apiServer.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PATCH, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Restaurant-Id"
      }
    },
    {
      "src": "/",
      "dest": "/index.js"
    }
  ]
}
