{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "almenupro-backend",
  "framework": null,
  "installCommand": "node scripts/preparePublicUploads.js",
  "buildCommand": "node scripts/preparePublicUploads.js && node scripts/verifyVercelDeploy.js",
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "lib/**/*.js",
          "uploads/menu/**",
          "public/menu-images/**"
        ]
      }
    },
    {
      "src": "apiServer.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "lib/**/*.js",
          "uploads/menu/**",
          "public/menu-images/**"
        ]
      }
    },
    {
      "src": "api/kitchens.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "lib/**/*.js"
        ]
      }
    },
    {
      "src": "api/delivery-zones.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "lib/**/*.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/kitchens",
      "dest": "/api/kitchens.js"
    },
    {
      "src": "/api/kitchens/(.*)",
      "dest": "/api/kitchens.js"
    },
    {
      "src": "/api/delivery-zones",
      "dest": "/api/delivery-zones.js"
    },
    {
      "src": "/api/delivery-zones/(.*)",
      "dest": "/api/delivery-zones.js"
    },
    {
      "src": "/(.*)",
      "dest": "/apiServer.js"
    }
  ]
}
